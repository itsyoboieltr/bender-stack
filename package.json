{
  "name": "bender-stack",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --clear --port 3000",
    "build": "expo export --platform web",
    "start": "bun index.ts",
    "check": "biome check",
    "i18n:extract": "lingui extract --overwrite --clean",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun seed.ts",
    "auth:generate": "bunx @better-auth/cli generate --output server/routers/auth/table.ts",
    "auth:secret": "bunx @better-auth/cli secret",
    "email:dev": "cp .env ./node_modules/@react-email/preview-server && email dev --port 3001 --dir lib/emails",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@better-auth/expo": "1.3.34",
    "@formatjs/intl-locale": "4.2.13",
    "@formatjs/intl-pluralrules": "5.4.6",
    "@lingui/core": "5.5.2",
    "@lingui/react": "5.5.2",
    "@react-email/components": "0.5.7",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/label": "1.2.0",
    "@rn-primitives/slot": "1.2.0",
    "@rn-primitives/types": "1.2.0",
    "@tanstack/react-form": "1.23.8",
    "@tanstack/react-query": "5.90.6",
    "@trpc/client": "11.7.1",
    "@trpc/server": "11.7.1",
    "@trpc/tanstack-react-query": "11.7.1",
    "better-auth": "1.3.34",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-kit": "0.31.6",
    "drizzle-orm": "0.44.7",
    "drizzle-zod": "0.8.3",
    "expo": "^54.0.0",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "18.0.10",
    "expo-dev-client": "~6.0.16",
    "expo-linking": "8.0.8",
    "expo-localization": "~17.0.7",
    "expo-router": "~6.0.14",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-web-browser": "15.0.8",
    "input-otp-native": "0.4.0",
    "lucide-react-native": "0.552.0",
    "nativewind": "4.2.1",
    "negotiator": "1.0.0",
    "nodemailer": "7.0.10",
    "pg": "8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "2.2.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "react-qr-code": "2.0.18",
    "tailwind-merge": "2.6.0",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "ulidx": "2.4.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@biomejs/biome": "2.3.2",
    "@lingui/babel-plugin-lingui-macro": "5.5.2",
    "@lingui/metro-transformer": "5.5.2",
    "@react-email/preview-server": "4.3.2",
    "@types/bun": "1.3.1",
    "@types/negotiator": "0.6.4",
    "@types/nodemailer": "7.0.3",
    "@types/pg": "8.15.6",
    "@types/react": "~19.1.10",
    "react-email": "4.3.2",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
