{
  "name": "bender-stack",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --clear --port 3000",
    "build": "expo export --platform web",
    "start": "bun index.ts",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --check .",
    "db:push": "drizzle-kit push",
    "auth:generate": "@better-auth/cli generate --output server/routers/auth/table.ts",
    "auth:secret": "@better-auth/cli secret",
    "email:dev": "cp .env ./node_modules/react-email/dist/preview && email dev --port 3001 --dir lib/emails",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-email/components": "0.0.32",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@rn-primitives/label": "1.1.0",
    "@rn-primitives/slot": "1.1.0",
    "@rn-primitives/types": "1.1.0",
    "@tanstack/react-query": "5.64.2",
    "@trpc/client": "11.0.0-rc.666",
    "@trpc/react-query": "11.0.0-rc.666",
    "@trpc/server": "11.0.0-rc.666",
    "better-auth": "1.1.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-kit": "0.30.2",
    "drizzle-orm": "0.38.4",
    "drizzle-zod": "0.6.1",
    "expo": "~52.0.26",
    "expo-constants": "~17.0.4",
    "expo-dev-client": "~5.0.10",
    "expo-linking": "~7.0.4",
    "expo-router": "~4.0.17",
    "expo-splash-screen": "~0.29.21",
    "expo-status-bar": "~2.0.1",
    "lucide-react-native": "0.474.0",
    "nativewind": "4.1.23",
    "nodemailer": "6.10.0",
    "postgres": "3.4.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.6",
    "react-native-reanimated": "~3.16.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-toast-message": "2.2.1",
    "react-native-web": "~0.19.13",
    "react-timer-hook": "3.0.8",
    "tailwind-merge": "2.6.0",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "ulidx": "2.4.1",
    "zod": "3.24.1",
    "zod-validation-error": "3.4.0"
  },
  "devDependencies": {
    "@better-auth/cli": "1.1.14",
    "@babel/core": "7.26.0",
    "@types/bun": "1.2.0",
    "@types/nodemailer": "6.4.17",
    "@types/react": "~18.3.16",
    "eslint": "8.56.0",
    "eslint-config-universe": "14.0.0",
    "eslint-plugin-drizzle": "0.2.3",
    "prettier": "3.4.2",
    "prettier-plugin-tailwindcss": "0.6.11",
    "react-email": "3.0.6",
    "typescript": "5.7.3"
  },
  "patchedDependencies": {
    "layerr@3.0.0": "patches/layerr@3.0.0.patch"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
