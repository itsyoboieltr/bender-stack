{
  "name": "bender-stack",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --clear --port 3000",
    "build": "expo export --platform web",
    "start": "bun index.ts",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --check .",
    "db:push": "drizzle-kit push",
    "auth:generate": "bunx @better-auth/cli generate --output server/routers/auth/table.ts",
    "auth:secret": "bunx @better-auth/cli secret",
    "email:dev": "cp .env ./node_modules/react-email/dist/preview && email dev --port 3001 --dir lib/emails",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-email/components": "0.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@rn-primitives/label": "1.2.0",
    "@rn-primitives/slot": "1.2.0",
    "@rn-primitives/types": "1.2.0",
    "@tanstack/react-query": "5.80.10",
    "@trpc/client": "11.4.2",
    "@trpc/tanstack-react-query": "11.4.2",
    "@trpc/server": "11.4.2",
    "better-auth": "1.2.9",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-kit": "0.31.1",
    "drizzle-orm": "0.44.2",
    "drizzle-zod": "0.8.2",
    "expo": "^53.0.12",
    "expo-clipboard": "~7.1.4",
    "expo-constants": "~17.1.6",
    "expo-dev-client": "~5.2.1",
    "expo-linking": "~7.1.5",
    "expo-router": "~5.1.0",
    "expo-splash-screen": "~0.30.9",
    "expo-status-bar": "~2.2.3",
    "input-otp-native": "0.4.0",
    "lucide-react-native": "0.518.0",
    "nativewind": "4.1.23",
    "nodemailer": "7.0.3",
    "postgres": "3.4.7",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.4",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-toast-message": "2.2.1",
    "react-native-web": "^0.20.0",
    "react-qr-code": "2.0.16",
    "tailwind-merge": "2.6.0",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "ulidx": "2.4.1",
    "zod": "3.25.67",
    "zod-validation-error": "3.5.2"
  },
  "devDependencies": {
    "@babel/core": "7.27.4",
    "@types/bun": "1.2.16",
    "@types/nodemailer": "6.4.17",
    "@types/react": "~19.0.10",
    "eslint": "8.56.0",
    "eslint-config-universe": "14.0.0",
    "eslint-plugin-drizzle": "0.2.3",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.13",
    "react-email": "4.0.16",
    "typescript": "~5.8.3"
  },
  "patchedDependencies": {
    "layerr@3.0.0": "patches/layerr@3.0.0.patch"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "lucide-react-native"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
