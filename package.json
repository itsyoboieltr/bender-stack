{
  "name": "bender-stack",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --clear --port 3000",
    "build": "expo export --platform web",
    "start": "bun index.ts",
    "check": "biome check .",
    "i18n:extract": "lingui extract --overwrite --clean",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun seed.ts",
    "auth:generate": "bunx @better-auth/cli generate --output server/routers/auth/table.ts",
    "auth:secret": "bunx @better-auth/cli secret",
    "email:dev": "cp .env ./node_modules/react-email/dist/preview && email dev --port 3001 --dir lib/emails",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@formatjs/intl-locale": "4.2.11",
    "@formatjs/intl-pluralrules": "5.4.4",
    "@lingui/core": "5.3.3",
    "@lingui/react": "5.3.3",
    "@react-email/components": "0.3.2",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@rn-primitives/label": "1.2.0",
    "@rn-primitives/slot": "1.2.0",
    "@rn-primitives/types": "1.2.0",
    "@tanstack/react-form": "1.14.1",
    "@tanstack/react-query": "5.83.0",
    "@trpc/client": "11.4.3",
    "@trpc/server": "11.4.3",
    "@trpc/tanstack-react-query": "11.4.3",
    "better-auth": "1.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-kit": "0.31.4",
    "drizzle-orm": "0.44.3",
    "drizzle-zod": "0.8.2",
    "expo": "53.0.20",
    "expo-clipboard": "~7.1.4",
    "expo-constants": "~17.1.6",
    "expo-dev-client": "~5.2.2",
    "expo-linking": "~7.1.5",
    "expo-localization": "~16.1.5",
    "expo-router": "~5.1.4",
    "expo-secure-store": "~14.2.3",
    "expo-splash-screen": "~0.30.9",
    "expo-status-bar": "~2.2.3",
    "input-otp-native": "0.4.0",
    "lucide-react-native": "0.525.0",
    "nativewind": "4.1.23",
    "negotiator": "1.0.0",
    "nodemailer": "7.0.5",
    "postgres": "3.4.7",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-toast-message": "2.2.1",
    "react-native-web": "^0.20.0",
    "react-qr-code": "2.0.18",
    "tailwind-merge": "2.6.0",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7",
    "ulidx": "2.4.1",
    "zod": "4.0.5"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@biomejs/biome": "2.1.2",
    "@lingui/babel-plugin-lingui-macro": "5.3.3",
    "@lingui/metro-transformer": "5.3.3",
    "@types/bun": "1.2.19",
    "@types/negotiator": "0.6.4",
    "@types/nodemailer": "6.4.17",
    "@types/react": "~19.0.10",
    "react-email": "4.2.3",
    "typescript": "~5.8.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
