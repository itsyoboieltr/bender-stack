{
  "expo": {
    "scheme": "acme",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "orientation": "default",
    "web": {
      "output": "server",
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-localization", "expo-secure-store"],
    "ios": {
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "name": "bender-stack",
    "slug": "bender-stack"
  }
}
